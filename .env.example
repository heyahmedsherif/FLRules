# ── Email (optional — POC logs alerts to console + data/alerts_log.json) ──
# To send real emails, use a Gmail app password:
#   1. Enable 2FA on your Google account
#   2. Go to myaccount.google.com > Security > App passwords
#   3. Generate a password for "Mail"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=alerts@yourdomain.org

# ── Application ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/flrules.db
POLL_INTERVAL_MINUTES=60
LOG_LEVEL=INFO

# ── Optional: Admin dashboard ───────────────────────
ADMIN_SECRET=change-me-in-production
