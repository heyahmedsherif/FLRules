# ── SMS (Twilio) ────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Email (optional — free SMTP via Gmail app password) ──
# Without these, email alerts log to console only
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=alerts@yourdomain.org

# ── Application ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/flrules.db
POLL_INTERVAL_MINUTES=60
LOG_LEVEL=INFO
